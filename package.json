{
  "name": "vscode-jira-branching",
  "displayName": "vscode-jira-branching",
  "publisher": "danialidhamyahya",
  "description": "VS Code extension to create Git branches from assigned Jira tickets.",
  "repository": {
    "type": "git",
    "url": "https://github.com/danialidham/vscode-jira-branching"
  },
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.102.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:jiraBrancherUnified.view",
    "onCommand:jiraBrancher.createBranch"
  ],
  "contributes": {
    "configuration": {
      "title": "Jira Brancher",
      "properties": {
        "jiraBrancher.jiraDomain": {
          "type": "string",
          "default": "",
          "description": "Your Jira domain, e.g. mycompany.atlassian.net"
        },
        "jiraBrancher.jiraEmail": {
          "type": "string",
          "default": "",
          "description": "Your Jira account email"
        },
        "jiraBrancher.jiraToken": {
          "type": "string",
          "default": "",
          "description": "Your Jira API token"
        }
      }
    },
    "commands": [
      {
        "command": "jiraBrancher.createBranch",
        "title": "Jira Brancher: Create Branch"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jiraBrancherWebview",
          "title": "Jira Brancher",
          "icon": "./icon-danial.svg"
        }
      ]
    },
    "views": {
      "jiraBrancherWebview": [
        {
          "type": "webview",
          "id": "jiraBrancherUnified.view",
          "name": "Jira Issues"
        }
      ]
    }
  },
  "scripts": {
    "watch": "tsc -w -p ./",
    "compile": "node esbuild.config.js",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.7",
    "@types/vscode": "^1.102.0",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "axios": "^1.10.0"
  }
}