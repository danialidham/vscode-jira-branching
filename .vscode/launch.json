{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Jira Brancher (bucket)",
      "type": "extensionHost",
      "request": "launch",

      // Start the Dev‑Host by running the same VS Code executable
      "runtimeExecutable": "${execPath}",

      // 1) Tell VS Code where your extension’s package.json lives
      // 2) Tell the Dev‑Host to open that folder as the workspace
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/buckets/jira-brancher",
        "${workspaceFolder}/buckets/jira-brancher"
        /*      ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^  this final bare path
                becomes the folder that opens in the Dev‑Host window   */
      ],

      // compiled JavaScript output
      "outFiles": [
        "${workspaceFolder}/buckets/jira-brancher/out/**/*.js"
      ]
    }
  ]
}
